{
  "name": "codex-model-watch",
  "version": "0.1.5",
  "description": "Local Codex model usage monitor",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.codex.modelwatch",
    "productName": "Codex Model Watch",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/assets/AppIcon.icns",
      "target": ["dmg", "zip"]
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "codex_model_watch.py",
      "README*",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "codex_model_watch.py",
      "web/**/*",
      "electron/assets/tray-icon.png"
    ]
  }
}
